# ============================================================
# PeakGuard Roofing — Environment Variables
# ============================================================
# Copy this file to .env.local for Sandbox local development.
# NEVER commit .env.local or any file containing real secrets.
#
# In production, set server secrets via the Whop CLI:
#   npx @whop/cli apps secrets set --secret KEY=value
# ============================================================

# ── Server / Sandbox Runtime Configuration ──────────────────
WHOP_API_ORIGIN=https://sandbox-api.whop.com
WHOP_ACCOUNT_ID=biz_YOUR_SANDBOX_ACCOUNT_ID
WHOP_API_KEY=apik_YOUR_SANDBOX_COMPANY_API_KEY

# Optional per-environment public plan overrides (also configurable directly in src/site.config.ts)
# VITE_WHOP_ENVIRONMENT=sandbox
# VITE_WHOP_SANDBOX_ACCOUNT_ID=biz_YOUR_SANDBOX_ACCOUNT_ID
# VITE_WHOP_SANDBOX_PLAN_INSPECTION=plan_...
# VITE_WHOP_SANDBOX_PLAN_DEPOSIT=plan_...
# VITE_WHOP_SANDBOX_PLAN_TUNEUP=plan_...

# ── Secrets required for Admin Invoicing & Webhook Security ─
# Create via Whop Developer Dashboard / Webhooks API:
WHOP_WEBHOOK_SECRET=ws_REPLACE_ME

# Random 32+ character string protecting /admin/invoicing and /api/invoice/final-balance
ADMIN_SECRET=REPLACE_WITH_RANDOM_STRING_32_CHARS_MINIMUM
