# ============================================================
# PeakGuard Roofing — Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file with real secrets.
#
# In production: set all secrets via the Whop CLI:
#   whop apps secrets set --secret KEY=value
# ============================================================

# ── Auto-injected by Whop's hosting runtime ─────────────────
# These are provided automatically in both `whop apps dev` and
# the production runtime. DO NOT set them manually in production.
# For local development outside whop apps dev, set these to your
# sandbox values.
#
# WHOP_API_ORIGIN=https://sandbox-api.whop.com   # Sandbox
# WHOP_API_ORIGIN=https://api.whop.com            # Production (injected automatically)
#
# WHOP_ACCOUNT_ID=biz_xxxxxxxxxxxx               # Your biz_ account ID
# WHOP_APP_ID=app_xxxxxxxxxxxx                   # Your app_ ID

# ── Secrets you must set via `whop apps secrets set` ────────

# Webhook secret — obtained when you create a webhook via the Whop API or dashboard.
# The API shows this value ONLY ONCE. Store it immediately.
# Example: whop apps secrets set --secret WHOP_WEBHOOK_SECRET=ws_xxxxxxxx
WHOP_WEBHOOK_SECRET=ws_REPLACE_ME

# Admin secret — a random string you generate to protect the invoice admin endpoint.
# Generate one with: openssl rand -hex 32
# Example: whop apps secrets set --secret ADMIN_SECRET=abc123...
ADMIN_SECRET=REPLACE_WITH_RANDOM_STRING_32_CHARS_MINIMUM

